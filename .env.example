# Copy this file to .env and fill in values as needed.
# The application runs perfectly well with NEITHER key set -- RAG falls back
# to extractive answers (real document text, no hallucination risk) and the
# ML/anomaly/analytics features don't need an LLM at all.

# Optional: enables fluent LLM-generated RAG answers (see rag/qa.py) and the
# LLM-judge groundedness scorer (see llm/evaluation.py).
ANTHROPIC_API_KEY=

# Optional alternative to the above.
OPENAI_API_KEY=

# Never commit a real .env file. This .env.example contains no real secrets.
